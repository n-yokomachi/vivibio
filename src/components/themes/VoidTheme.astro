---
import { PROFILE, LINKS, OUTPUTS, CREDENTIALS } from '../../data/profile';
import VoidFx from '../VoidFx.astro';

// bio は「whatever the problem needs.」までを1行に収め、Currently〜 を2行目にする
const [bioMain, bioNow] = PROFILE.bio.split(/\s+(?=Currently)/);
// 英語の bio の2行と行の位置を揃えるため、日本語も「。」で2行に分ける
const [bioJaMain, bioJaNow] = PROFILE.bioJa.split(/(?<=。)/);

// contact（Email）は void には出さない
const CATEGORY_ORDER = ['social', 'code', 'talks', 'writing', 'creds', 'design', 'self'];
const sortedLinks = LINKS.filter((l) => CATEGORY_ORDER.includes(l.category)).sort(
  (a, b) => CATEGORY_ORDER.indexOf(a.category) - CATEGORY_ORDER.indexOf(b.category)
);
---

<div class="void">
  <header class="vd-head vd-bilingual" id="vd-bilingual">
    <div class="vd-layer vd-en">
      <h1 class="vd-name">
        <span class="vd-prompt" aria-hidden="true">&gt;</span>
        {PROFILE.name} ({PROFILE.handle}) — {PROFILE.title}
      </h1>
      <p class="vd-creds">{CREDENTIALS[0]}<br />{CREDENTIALS[1]}</p>
      <p class="vd-bio">{bioMain}<br />{bioNow}</p>
    </div>
    <div class="vd-layer vd-ja" lang="ja" aria-hidden="true">
      <p class="vd-name">
        <span class="vd-prompt">&gt;</span>
        {PROFILE.nameJa} ({PROFILE.handle}) — ソフトウェアエンジニア / AIエンジニア
      </p>
      <p class="vd-creds">{CREDENTIALS[0]}<br />{CREDENTIALS[1]}</p>
      <p class="vd-bio">{bioJaMain}<br />{bioJaNow}</p>
    </div>
    <div class="vd-ring-layer" aria-hidden="true"><span class="vd-ring"></span></div>
  </header>

  <section aria-label="links">
    <h2 class="vd-rule">-- links --------------------------------</h2>
    <ul class="vd-list">
      {
        sortedLinks.map((l) => (
          <li>
            <a class="vd-row vd-lrow" href={l.url} target="_blank" rel="noopener noreferrer">
              <span class="vd-cat">{l.category}</span>
              <span class="vd-label" data-swarm={l.swarmLabel ?? l.label}>{l.label}</span>
              <span class="vd-handle">{l.handle}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section aria-label="outputs">
    <h2 class="vd-rule">-- outputs ------------------------------</h2>
    <ul class="vd-list">
      {
        OUTPUTS.map((o) => (
          <li>
            <a class="vd-row vd-orow" href={o.url} target="_blank" rel="noopener noreferrer">
              <span class="vd-cat">{o.badge}</span>
              <span class="vd-title">{o.title}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <footer class="vd-status">
    <span class="vd-dot" aria-hidden="true"></span>
    <span>tokyo, japan</span>
  </footer>

  <VoidFx />

  <button class="vd-back" id="vd-back" type="button">[ back to the front page ]</button>
</div>

<script>
  document.getElementById('vd-back')?.addEventListener('click', () => {
    (window as any).vivibioShowGate?.();
  });

  const bilingual = document.getElementById('vd-bilingual');
  if (bilingual) {
    const moveTo = (clientX: number, clientY: number) => {
      const r = bilingual.getBoundingClientRect();
      bilingual.style.setProperty('--mx', `${clientX - r.left}px`);
      bilingual.style.setProperty('--my', `${clientY - r.top}px`);
    };
    const hide = () => {
      bilingual.style.setProperty('--mx', '-999px');
      bilingual.style.setProperty('--my', '-999px');
    };
    window.addEventListener('mousemove', (e) => moveTo(e.clientX, e.clientY), { passive: true });
    document.documentElement.addEventListener('mouseleave', hide);
    window.addEventListener('touchstart', (e) => moveTo(e.touches[0].clientX, e.touches[0].clientY), { passive: true });
    window.addEventListener('touchmove', (e) => moveTo(e.touches[0].clientX, e.touches[0].clientY), { passive: true });
    window.addEventListener('touchend', hide);
    window.addEventListener('touchcancel', hide);

    // 枠線を名前の行と bio の文字の行の範囲だけに切り抜く
    const ringLayer = bilingual.querySelector<HTMLElement>('.vd-ring-layer');
    const ringTargets = bilingual.querySelectorAll<HTMLElement>('.vd-name, .vd-bio');
    const updateRingClip = () => {
      if (!ringLayer) return;
      const b = bilingual.getBoundingClientRect();
      const range = document.createRange();
      let d = '';
      ringTargets.forEach((el) => {
        range.selectNodeContents(el);
        for (const q of range.getClientRects()) {
          if (q.width < 1) continue;
          const x = q.left - b.left - 2;
          const y = q.top - b.top - 2;
          d += `M${x} ${y}h${q.width + 4}v${q.height + 4}h${-(q.width + 4)}Z`;
        }
      });
      ringLayer.style.clipPath = d ? `path('${d}')` : 'inset(100%)';
    };
    new ResizeObserver(updateRingClip).observe(bilingual);
    document.fonts?.ready.then(updateRingClip);
  }
</script>

<style>
  .void {
    position: relative;
    z-index: 1;
    max-width: 720px;
    margin: 0 auto;
    padding: 72px 20px 56px;
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 14px;
    line-height: 1.9;
    color: var(--vd-text);
  }
  .vd-head {
    margin-bottom: 40px;
  }
  .vd-name {
    margin: 0 0 12px;
    font-size: 16px;
    font-weight: 700;
    letter-spacing: 0.04em;
    color: var(--vd-strong);
  }
  .vd-prompt {
    color: var(--void-accent);
  }
  .vd-creds {
    margin: 0 0 14px;
    color: var(--vd-creds);
  }
  .vd-bio {
    margin: 0;
  }
  .vd-rule {
    margin: 36px 0 10px;
    font-size: 13px;
    font-weight: 400;
    letter-spacing: 0.08em;
    color: var(--vd-dim);
    white-space: nowrap;
    overflow: hidden;
    /* 罫線の長さがページの最小幅を押し広げないようにする（幅 375px で横にはみ出すため） */
    contain: inline-size;
  }
  .vd-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .vd-row {
    display: grid;
    grid-template-columns: 9ch 14ch 1fr;
    gap: 0 16px;
    padding: 1px 0;
    text-decoration: none;
    color: var(--vd-text);
    transition: color 0.15s ease;
  }
  .vd-orow {
    grid-template-columns: 9ch 1fr;
  }
  .vd-cat {
    color: var(--vd-dim);
    transition: color 0.15s ease;
  }
  .vd-handle,
  .vd-title {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  /* リンク行の当たり判定は文字だけにする。行の空白は押せない */
  .vd-lrow {
    pointer-events: none;
  }
  .vd-lrow > span {
    justify-self: start;
    max-width: 100%;
    pointer-events: auto;
  }
  .vd-row:hover,
  .vd-row:focus-visible,
  .vd-row:hover .vd-cat,
  .vd-row:focus-visible .vd-cat {
    color: var(--void-accent);
  }
  .vd-status {
    margin-top: 48px;
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--vd-dim);
    font-size: 13px;
  }
  .vd-back {
    margin-top: 28px;
    padding: 0;
    font-family: inherit;
    font-size: 13px;
    letter-spacing: 0.08em;
    color: var(--vd-dim);
    background: none;
    border: none;
    cursor: pointer;
    transition: color 0.15s ease;
  }
  .vd-back:hover,
  .vd-back:focus-visible {
    color: var(--void-accent);
  }
  .vd-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #3adb76;
    box-shadow: 0 0 6px rgba(58, 219, 118, 0.8);
  }
  .vd-bilingual {
    --mx: -999px;
    --my: -999px;
    display: grid;
  }
  .vd-layer {
    grid-area: 1 / 1;
  }
  /* 円の枠線。clip-path で名前の行と bio の文字の範囲だけに出す（JS で計算する） */
  .vd-ring-layer {
    grid-area: 1 / 1;
    position: relative;
    pointer-events: none;
    clip-path: inset(100%);
  }
  .vd-ring {
    position: absolute;
    left: calc(var(--mx) - 95px);
    top: calc(var(--my) - 95px);
    width: 190px;
    height: 190px;
    border: 1px solid var(--void-accent);
    border-radius: 50%;
    opacity: 0.6;
  }
  .vd-en {
    -webkit-mask-image: radial-gradient(circle at var(--mx) var(--my), transparent 80px, #000 110px);
    mask-image: radial-gradient(circle at var(--mx) var(--my), transparent 80px, #000 110px);
  }
  .vd-ja {
    pointer-events: none;
    user-select: none;
    -webkit-mask-image: radial-gradient(circle at var(--mx) var(--my), #000 80px, transparent 110px);
    mask-image: radial-gradient(circle at var(--mx) var(--my), #000 80px, transparent 110px);
  }
  .vd-ja .vd-name {
    margin: 0 0 12px;
  }
  /* 右上のボタン（配色と背景演出）が本文の列に重なる幅では、本文をボタンの下から始める */
  @media (max-width: 1100px) {
    .void {
      padding-top: 120px;
    }
  }
  @media (max-width: 520px) {
    .vd-lrow {
      grid-template-columns: 13ch 1fr;
    }
    .vd-lrow .vd-cat {
      display: none;
    }
  }
</style>
